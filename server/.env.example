# ── Django ──────────────────────────────────────
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production
# DEBUG must be False in any environment reachable by real users — verbose error pages
# leak secrets/stack traces. Only set True for local development.
DEBUG=True
# Comma-separated list of hostnames this server will answer as. REQUIRED (no wildcard
# fallback) once DEBUG=False — e.g. exam-cell-server.onrender.com
ALLOWED_HOSTS=*

# ── MongoDB ──────────────────────────────────────
# Local: mongodb://localhost:27017   Atlas: mongodb+srv://user:pass@cluster.xxxx.mongodb.net
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=ExamCellQueueDB
# Only used when running `manage.py test` — routes tests to an isolated database so they
# never touch real queue data.
MONGO_DB_NAME_TEST=ExamCellQueueDB_test

# ── Auth ─────────────────────────────────────────
# Signs access tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# AES-256-GCM key for emails/names at rest, and a SEPARATE HMAC key for lookups + OTP hashes.
# Generate each with: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Never change these on a database with existing accounts (stored data becomes unreadable).
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
# Comma-separated emails allowed to sign up / log in as staff.
STAFF_EMAILS=you@example.com
# Optional tuning (defaults shown)
# ACCESS_TOKEN_EXP_SECONDS=1800
# STUDENT_REFRESH_TOKEN_EXP_SECONDS=2592000
# STAFF_REFRESH_TOKEN_EXP_SECONDS=86400
# OTP_EXPIRY_MINUTES=10
# OTP_RESEND_COOLDOWN_SECONDS=45
# MAX_OTP_ATTEMPTS=5
# MAX_LOGIN_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# ── URLs ─────────────────────────────────────────
# Google redirects to BACKEND_URL/api/v1/main/auth/google/callback/ — register exactly that
# as an Authorized redirect URI in Google Cloud Console.
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080

# ── Google sign-in ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Brevo) ────────────────────────────────
# Unset while DEBUG=True: OTP codes are printed to the server console instead of emailed.
# BREVO_API_KEY=
# EMAIL_SENDER_ADDRESS=noreply@your-domain.com
# EMAIL_SENDER_NAME=Smart Exam Cell

# ── Queue ────────────────────────────────────────
# Number of service counters created on first start (Counter 1..N).
COUNTER_COUNT=3
# Wait estimates use the day's real average service time; this is only the fallback before
# any student has been served today.
DEFAULT_SERVICE_MINUTES=5
# Max appointments per 15-minute slot, across all services.
SLOT_CAPACITY=3
# How many days ahead students may book an appointment.
BOOKING_WINDOW_DAYS=30
# Appointments are called ahead of walk-ins from this many minutes before their slot.
APPOINTMENT_GRACE_MINUTES=5

# ── CORS ─────────────────────────────────────────
# Comma-separated list of your real frontend origins (the Netlify site). REQUIRED (no
# wildcard fallback) once DEBUG=False.
# CORS_ALLOWED_ORIGINS=https://your-site.netlify.app
